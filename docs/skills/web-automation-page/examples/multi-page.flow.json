{
  "version": 2,
  "name": "multiPageAudit",
  "title": {
    "zh": "跨站点/多标签页巡检",
    "en": "Multi-page Audit"
  },
  "description": "Playwright 示例：跨域、多页面、截图。",
  "mode": "playwright",
  "baseUrl": "https://example.com",
  "pages": [
    {
      "id": "main",
      "url": "https://example.com/"
    },
    {
      "id": "admin",
      "url": "https://admin.example.com/"
    }
  ],
  "steps": [
    {
      "action": "goto",
      "url": "/"
    },
    {
      "action": "waitFor",
      "selector": "h1"
    },
    {
      "action": "extract",
      "selector": "h1",
      "as": "homeTitle"
    },
    {
      "page": "admin",
      "action": "waitFor",
      "selector": "h1"
    },
    {
      "action": "assert",
      "selector": "h1",
      "contains": "Admin"
    },
    {
      "action": "screenshot",
      "fullPage": true
    }
  ]
}
