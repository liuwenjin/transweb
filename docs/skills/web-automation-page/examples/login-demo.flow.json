{
  "version": 2,
  "name": "loginDemo",
  "title": {
    "zh": "登录并检查仪表盘",
    "en": "Login and Check Dashboard"
  },
  "description": "同源示例：自动登录、等待跳转、断言并提取用户 ID。",
  "mode": "inpage",
  "baseUrl": "/",
  "vars": {
    "email": "demo@example.com"
  },
  "secrets": [
    "PASSWORD"
  ],
  "defaultTimeout": 20000,
  "pages": [
    {
      "id": "main",
      "url": "/login"
    }
  ],
  "steps": [
    {
      "action": "goto",
      "url": "/login"
    },
    {
      "action": "waitFor",
      "selector": "#email"
    },
    {
      "action": "fill",
      "selector": "#email",
      "value": "{{email}}"
    },
    {
      "action": "fill",
      "selector": "#password",
      "value": "{{secret.PASSWORD}}"
    },
    {
      "action": "click",
      "selector": "button[type=submit]"
    },
    {
      "action": "waitFor",
      "url": "**/dashboard",
      "timeout": 30000
    },
    {
      "action": "assert",
      "selector": "h1",
      "contains": "仪表盘"
    },
    {
      "action": "extract",
      "selector": ".user-id",
      "as": "userId"
    },
    {
      "action": "log",
      "message": "当前用户：{{userId}}"
    }
  ]
}
