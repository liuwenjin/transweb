node_modules
.env
*.log
.DS_Store

# ---- 以点开头的隐藏文件夹（及其中的所有文件）一律不纳入版本库 ----
# 例：.dsh/、.vscode/、static/.chrome-*/
# 说明：末尾的 / 表示只匹配目录，因此本文件 .gitignore 与 .env.example 等点文件不受影响
.*/
temp_uploads/
temp/
tmp/

# ---- 构建产物（勿提交）----
# 安装包体积过大（单文件约 130MB，超过 GitHub 100MB 限制），请通过 Releases 分发
dist/*.tgz

# ---- 不随仓库/安装包发布的内部资料 ----
# 内部文档与 PRD（含预算、需求等商业资料）
docs/
# OA 演示项目（仅本地演示用）
static/oa-demo/
static/oa-demo.zip

# ---- 敏感 / 运行时数据（勿提交）----
# HTTPS 证书与私钥
ca/
# 用户个人空间数据
personal/
# 微信支付流水日志
wxPayLog/
# 用户文档等个人数据
static/bucket/personal/
# 登录会话（含真实用户 PII）
interface/config/logined.js
# 访客会话数据
interface/config/guest.js
# 备份文件
interface/config/appConfig.bak.js
# DSH skill 运行时配置 / 生成结果备份（含 API Key，勿提交）
.dsh/transweb-ppt.json
.dsh/transweb-ppt-last-deck.json
.dsh/transweb-ai.json

# ---- Growth Agent 运行时产物 ----
growth/.cache/
growth/dist/
growth/data/drafts/
growth/data/runs/
growth/data/snapshots/
growth/data/browser-profiles/
growth/data/credentials.enc.json
growth/data/credential-health.json
growth/data/publish-jobs.json
growth/data/link-checks.json
growth/data/.credential-key
growth/data/reports/
