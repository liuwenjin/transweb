# 本地开发配置（已被 .gitignore 忽略，切勿提交）
# 注意：下列值部分沿用历史默认值以保证本地环境不中断，均需尽快轮换（见 TODO 标注）。

PORT=80
HOST=0.0.0.0
SSLPORT=443

# ---- 公网部署开关（1.4.0 起）----
# 关闭 /admin.html、/initAdmin.html 等后台页面（初始化完成后建议设为 1）
TRANSWEB_DISABLE_ADMIN=
# 若部署在 nginx/CDN 之后设为 1，否则限流与微信支付取到的 IP 会变成代理地址
TRUST_PROXY=

# ---- 数据库 ----
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DATABASE=xxx
# 若 MongoDB 未开启鉴权，将 MONGO_USERNAME / MONGO_APP_PWD 留空即可无凭据连接
MONGO_USERNAME=xxx
# TODO(轮换): 沿用 initDb.sh 初始口令，请在 MongoDB 同步更换
MONGO_ADMIN_PWD=xxx
MONGO_APP_PWD=xxx
# 可选：用户创建在 admin 库时设为 admin，否则留空
MONGO_AUTH_SOURCE=

# ---- 会话（已随机生成）----
SESSION_SECRET=xxx

# ---- API Key 鉴权（用于对 API Key 哈希加盐，建议随机生成）----
API_KEY_SALT=xxx

# ---- 管理员 ----
# TODO(轮换): 以下为历史默认值，请更换
ADMIN_ACCOUNT=xxx
POWER_ADMIN=xxx
ADMIN_KEY=xxx


# JEV 接口地址（需 http:// 或 https:// 开头）
JEV_API_ENDPOINT=https://api.typesafe.ai/v1/systemone


# 短信验证码：螺丝帽 sms-api.luosimao.com，Key 形如 key-xxxxxxxx
SEND_MESSAGE_API_KEY=key-xxxx

# ---- 第三方 API Key ----
# TODO(轮换): 下列 Key 曾硬编码在源码中，视为已泄露，必须到对应供应商控制台吊销并重新生成
API_KEY_BAISHAN=sk-xxx
API_KEY_NOVITA=xxx
API_KEY_ALIYUN_IMAGE=sk-xxxx
API_KEY_302AI_IMAGE=sk-xxx
API_KEY_ZHIPU_IMAGE_ANALYSIS=sk-xxx
API_KEY_AUDIO2TEXT=sk-xxx
API_KEY_TEXT2AUDIO=sk-xxx
API_KEY_VECTRUST=sk-xxx
API_KEY_DEEPSEEK=sk-xxx
API_KEY_DMXAPI=sk-xxx
API_KEY_JEV=xxx
API_KEY_TONGYI=sk-xxx
API_KEY_MOONSHOT=sk-xxx


#----- 微信（腾讯服务）-----
# 微信支付走 APIv2（统一下单 + MD5 签名），必填：APP_ID、MCH_ID、APP_KEY
# WX_PAY_APP_ID  ：公众号/服务号 AppID（wx 开头），JSAPI/扫码支付用
# WX_PAY_APP_SECRET：公众号 AppSecret，仅网页授权取 openid 时需要
# WX_PAY_APP_KEY ：商户平台 APIv2 密钥（32 位，API 安全 → 密钥设置）
# WX_PAY_MCH_ID  ：微信支付商户号（10 位数字）
# WX_PAY_NOTIFY  ：支付回调地址，必须公网 HTTPS 可达；留空用 https://transweb.cn/receiveWxNotify
WX_PAY_APP_ID=
WX_PAY_APP_SECRET=
# TODO(轮换): 微信支付 API v2 密钥（MD5 签名），勿再硬编码
WX_PAY_APP_KEY=
WX_PAY_MCH_ID=
WX_PAY_NOTIFY=

# 小程序/App 通道（recharge.vue 中 type=wxApp 时使用）
# 代码优先读取 ..._ID001 / ..._SECRET001，同时兼容旧名 ..._ID01 / ..._SECRET01
WX_PAY_APP_ID001=
WX_PAY_APP_SECRET001=

# ---- 各模型/语音/搜索供应商 Key（从 interface/config/interface.js 硬编码迁移，均需轮换）----
API_KEY_VOLCANO_TTS=
API_KEY_COZE_PAT=
COZE_SOURCE=
API_KEY_VOLCANO_IMAGE=
API_KEY_PIXMILLER=
API_KEY_ZHIPU_TEXT=
API_KEY_ZHIPU_IMAGE=
API_KEY_SERPAPI=
API_KEY_AZURE_SPEECH=
